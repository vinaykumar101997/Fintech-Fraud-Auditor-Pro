# --- Model provider: "bedrock" (AWS) or "vertex" (GCP) ---
MODEL_PROVIDER=bedrock

# --- AWS (when MODEL_PROVIDER=bedrock) ---
AWS_REGION=us-east-1

# Must support tool use. Anthropic and Nova models do; Titan text does not.
# The "us." prefix is a cross-region inference profile: most current Claude
# models are only invocable through a profile, and using the bare model ID
# returns a ValidationException that does not explain why.
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Credentials come from the boto3 chain. In order of preference:
#   1. IAM role (App Runner, ECS task role, EC2 instance profile). Set nothing.
#   2. IAM Identity Center:  aws configure sso
#   3. Local dev:            aws configure
# Do not put AWS_SECRET_ACCESS_KEY in this file if you can avoid it.
# AWS_PROFILE=fraud-auditor

# --- Google Cloud (when MODEL_PROVIDER=vertex) ---
GCP_PROJECT_ID=your-project-id-here
GCP_LOCATION=us-central1

# Authentication.
#
# Do NOT place a service-account JSON key in the project root. The previous
# example recommended gcp-key.json, which the Dockerfile then copied into the
# image, publishing the key to anyone who pulled it.
#
# Preferred, in order:
#   1. Workload Identity (GKE / Cloud Run). Set nothing here.
#   2. Local development:  gcloud auth application-default login
#   3. Last resort: mount a key at runtime and point at the mount, never a
#      path inside the build context:
#        docker run -v /secure/path/key.json:/secrets/key.json:ro \
#                   -e GOOGLE_APPLICATION_CREDENTIALS=/secrets/key.json ...
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/key.json

# --- Qdrant ---
QDRANT_URL=https://your-cluster-id.us-east-4.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-api-key-here
QDRANT_COLLECTION=aml_compliance_docs

# --- Vertex models (vertex only) ---
VERTEX_CHAT_MODEL=gemini-2.5-flash
VERTEX_EMBED_MODEL=text-embedding-004

# --- Shared inference ---
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
# Titan Embed v2 = 1024, Vertex text-embedding-004 = 768. Defaults follow the
# provider. Switching providers means re-ingesting into a fresh collection.
# EMBEDDING_DIMENSIONS=1024

# --- Compliance thresholds (see config.py for the full set) ---
REPORTING_THRESHOLD=10000
STRUCTURING_FLOOR=8000
HIGH_RISK_COUNTRIES=Russia,North Korea,Iran,Syria,Belarus,Myanmar,Afghanistan
HITL_REVIEW_THRESHOLD=70
SCREENING_MATCH_THRESHOLD=88

# --- Tier 0 tuning ---
ANOMALY_Z_THRESHOLD=2.5
MAX_ML_FLAG_RATE=0.30
MIN_ROWS_FOR_ML=25

# --- Runtime ---
LLM_MAX_WORKERS=4
LLM_MAX_RETRIES=3
LOG_LEVEL=INFO
AUDIT_DB_PATH=data/audit_log.sqlite3
